# ============================================================
# VibeCoder Platform — Environment Variables
# ============================================================
# 复制为 .env 填入实际值。.env 已在 .gitignore 中排除

# -----------------------------------------------------------
# AI / LLM — DeepSeek V4 Flash
# -----------------------------------------------------------
# DeepSeek API Key（https://platform.deepseek.com/api_keys）
# 模型：deepseek-chat（OpenAI 兼容，V4 Flash 等效）
VITE_DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY

# -----------------------------------------------------------
# TON Blockchain
# -----------------------------------------------------------
# TON Center API Key（https://toncenter.com 注册获取）
TONCENTER_API_KEY=YOUR_TONCENTER_API_KEY
# TON 网络：testnet / mainnet
TON_NETWORK=testnet
# TON RPC（直连 lite servers，无需 API Key）
TONCLIENT4_TESTNET=https://testnet-v4.tonhubapi.com
TONCLIENT4_MAINNET=https://mainnet-v4.tonhubapi.com
# 合约部署助记词（24 词，仅部署用）
DEPLOYER_MNEMONIC="word1 word2 ... word24"
# 平台收款钱包
TON_PLATFORM_WALLET=YOUR_TON_PLATFORM_WALLET

# -----------------------------------------------------------
# Telegram
# -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=YOUR_TELEGRAM_BOT_USERNAME

# -----------------------------------------------------------
# Cloudflare
# -----------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
# D1 数据库（wrangler d1 create vibecoder-db 后获取）
D1_DATABASE_ID=YOUR_D1_DATABASE_ID

# -----------------------------------------------------------
# Frontend
# -----------------------------------------------------------
# Worker API 地址（部署后获得，如 https://api.vibecoder.workers.dev）
VITE_API_URL=https://YOUR_WORKER_SUBDOMAIN.workers.dev
# 前端 URL
APP_URL=https://YOUR_APP_DOMAIN

# -----------------------------------------------------------
# 外部 API（赏金验证，可选）
# -----------------------------------------------------------
X_API_BEARER_TOKEN=YOUR_X_API_BEARER_TOKEN
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
