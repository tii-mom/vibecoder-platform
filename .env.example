VC_DISTRIBUTION_PLAN=contracts/deployments/mainnet.vc-distribution.dry-run.json

# D1 sync helper defaults to dry-run. Use --apply only in a separate approved step.
PLATFORM_CONTRACTS_D1_DATABASE=vibecoder-db-new

# -----------------------------------------------------------
# SimpleLaunch v1 testnet (deployed + flow evidence)
# -----------------------------------------------------------
