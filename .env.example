# ============================================================
# VibeCoder Platform — Environment Variables
# ============================================================
# 复制此文件为 .env 后填入实际值。不要提交 .env 到 Git。

# -----------------------------------------------------------
# AI / LLM
# -----------------------------------------------------------
# Google Gemini API key（Copilot AI 评分、智能分析）
GEMINI_API_KEY=

# -----------------------------------------------------------
# TON Blockchain
# -----------------------------------------------------------
# TON Center API key（https://toncenter.com — 链上数据查询）
TONCENTER_API_KEY=
# TON 主网或测试网
TON_NETWORK=testnet
# 合约部署助记词（24 个单词，仅用于部署）
DEPLOYER_MNEMONIC=

# -----------------------------------------------------------
# Telegram
# -----------------------------------------------------------
# Telegram Bot Token（从 @BotFather 获取，用于 Mini App + 通知）
TELEGRAM_BOT_TOKEN=
# Bot 用户名（不含 @）
TELEGRAM_BOT_USERNAME=

# -----------------------------------------------------------
# Cloudflare
# -----------------------------------------------------------
# Cloudflare API Token（部署 Worker + D1 + Pages）
CLOUDFLARE_API_TOKEN=
# Cloudflare 账户 ID
CLOUDFLARE_ACCOUNT_ID=
# D1 数据库 ID（wrangler d1 create 后获取）
D1_DATABASE_ID=

# -----------------------------------------------------------
# Frontend
# -----------------------------------------------------------
# 前端部署 URL（Prod）
APP_URL=
# Worker API 地址
VITE_API_URL=

# -----------------------------------------------------------
# 外部 API（赏金验证）
# -----------------------------------------------------------
# X (Twitter) API Bearer Token（https://developer.x.com）
X_API_BEARER_TOKEN=
# Discord Bot Token（https://discord.com/developers）
DISCORD_BOT_TOKEN=
# TON Pay API Key（可选，https://tonpay.ton.org）
TONPAY_API_KEY=
