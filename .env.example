# -----------------------------------------------------------
# Mainnet dry-run planning only — does not broadcast transactions
# -----------------------------------------------------------
ALLOW_MAINNET_PLAN=0
MAINNET_ADMIN_ADDRESS=YOUR_MAINNET_ADMIN_WALLET_ADDRESS_HERE
VC_METADATA_URI=https://YOUR_MAINNET_METADATA_URI_HERE
