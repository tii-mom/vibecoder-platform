# ============================================================
# VibeCoder Frontend — Environment Variables
# ============================================================
# 复制为 .env.local 或 .env 填入实际值。
# 不要在本模板中提交真实 API key 或 token。

# -----------------------------------------------------------
# Frontend
# -----------------------------------------------------------
# Worker API 地址（部署后获得，如 https://api.vibecoder.workers.dev）
VITE_API_URL=
# 前端 TON 网络：testnet / mainnet
VITE_TON_NETWORK=testnet

# -----------------------------------------------------------
# AI / LLM — DeepSeek V4 Flash
# -----------------------------------------------------------
# 当前前端代码使用 DeepSeek，不再使用 Gemini / AI Studio 注入的 GEMINI_API_KEY。
# DeepSeek API Key（https://platform.deepseek.com/api_keys）
# 模型：deepseek-chat（OpenAI 兼容，V4 Flash 等效）
VITE_DEEPSEEK_API_KEY=

# -----------------------------------------------------------
# TON Contract Addresses
# -----------------------------------------------------------
VC_JETTON=
FUND=
VC_REWARD_POOL=
EARLY_FUNDRAISING=
LAUNCH_FEE=
TOKEN_LAUNCHER=

# -----------------------------------------------------------
# App
# -----------------------------------------------------------
# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# -----------------------------------------------------------
# Legacy template variables (unused)
# -----------------------------------------------------------
# GEMINI_API_KEY was part of the old AI Studio template and is not used by the current app.
# GEMINI_API_KEY=
